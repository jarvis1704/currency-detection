<?xml version="1.0" encoding="utf-8"?>
<!--
    Viewfinder brackets around a rupee sign: the scanner's on-screen markers framing a note.
    Everything stays inside the 66dp safe zone so no launcher mask clips it. Also used as the
    monochrome layer, where only the shape matters and the launcher supplies the colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M33,45 V33 H45 M63,33 H75 V45 M75,63 V75 H63 M45,75 H33 V63"
        android:strokeWidth="5"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M44,42 H64 M44,49 H64 M44,42 H51 A7,7 0 0,1 51,56 H44 L59,66"
        android:strokeWidth="5"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
